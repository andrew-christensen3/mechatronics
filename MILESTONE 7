#include "xc.h"


#pragma config ICS = PGx3

#pragma config FNOSC = LPFRC    //this is 500kHz

#define WHEEL_DIAMETER 90    //diamiter in mm
#define TURN90_MM    200 //(honestly just mess with this number till it works) 
#define PI           3.14159

void _delay(long time_msec)
{
    unsigned long cycles = time_msec * 250;   // 250 cycles = 1 millisecond
    __delay32(cycles);                        // wait that many cycles
}


void run(float mm) { // assume all lengths in mm and time is in msec
    float circumference = PI * WHEEL_DIAMETER;
    float revolutions = mm / circumference;
    long time_msec = revolutions * 1000;  // long just makes it so that it can accept more #s than just an int or float

    OC1RS = 1249;
    OC1R = 625;          //50% duty so motors run
    _delay(time_msec);   //just waits while the motors go
    OC1R = 0;            //duty 0 so motors stop
    
}

void forward(void) //this makes it move forward a meter
{
    _LATA2 = 0;
    _LATA1 = 1;          
    run(1000.0);
}

void turn90(void) //makes it turn 90 degrees with right turn
{
    _LATA2 = 0;
    _LATA1 = 0;        
    run(TURN90_MM);
}

void turn180(void) //makes it turn 180 degrees with right turn
{
    _LATA2 = 0;
    _LATA1 = 0;
    run(TURN90_MM * 2);      // THIS USES THE TURN90 FUNCTION TWICE 
}

// QRD SETUP FOR ANALOG INPUT
void config_pins_for_ad(void)
{
    // Configure the tri state adapter for input for all the analog pins
    TRISBbits.TRISB12 = 1; // Configure pin 15 for input    
    TRISBbits.TRISB13 = 1; // Configure pin 16 for input
    TRISBbits.TRISB14 = 1; // Configure pin 17 for input
    TRISBbits.TRISB15 = 1; // Configure pin 18 for input
    
    // Configure all the analog pins for analog (as opposed to digital)
    ANSBbits.ANSB12 = 1; // Configure pin 15 for analog    
    ANSBbits.ANSB13 = 1; // Configure pin 16 for analog
    ANSBbits.ANSB14 = 1; // Configure pin 17 for analog
    ANSBbits.ANSB15 = 1; // Configure pin 18 for analog
}

// QRD CONFIGURATION: using pins 15-18 to read the voltage for the line following (15-17) and ball sensing (pin 18)
void config_ad(void)
{
    _ADON = 0;    // AD1CON1<15> -- Turn off A/D during config
    
    // AD1CON1 register
    _ADSIDL = 0;  // AD1CON1<13> -- A/D continues in idle mode
    _MODE12 = 1;  // AD1CON1<10> -- 12-bit A/D operation
    _FORM = 0;    // AD1CON1<9:8> -- Unsigned integer output
    _SSRC = 7;    // AD1CON1<7:4> -- Auto conversion (internal counter)
    _ASAM = 1;    // AD1CON1<2> -- Auto sampling

    // AD1CON2 register
    _PVCFG = 0;   // AD1CON2<15:14> -- Use VDD as positive
                  // ref voltage
    _NVCFG = 0;   // AD1CON2<13> -- Use VSS as negative
                  // ref voltage
    _BUFREGEN = 1;// AD1CON2<11> -- Result appears in buffer
                  // location corresponding to channel
    _CSCNA = 1;   // AD1CON2<10> -- Scans inputs specified
                  // in AD1CSSx registers
    _SMPI = 3;	  // AD1CON2<6:2> -- Every 3th conversion sent (number of channels sampled -1)
                  // to buffer (if sampling 4 channels)
    _ALTS = 0;    // AD1CON2<0> -- Sample MUXA only
    
    // AD1CON3 register
    _ADRC = 0;    // AD1CON3<15> -- Use system clock
    _SAMC = 0;    // AD1CON3<12:8> -- Auto sample every A/D
                  // period TAD
    _ADCS = 0b00000011;    // AD1CON3<7:0> -- TAD needs to be at least 600 ns. Thus, _ADCS = 0b00000010 will give us the fastest AD clock given a 4 MHz system clock. 0b00000011 is slower than we could go, but still fast enough for our needs.

    // AD1CSS registers
    AD1CSSL = 0b0011110000000000; // choose A2D channels you'd like to scan here. we are choosing pin 15,16,17,& 18 which are associated with AN12,AN11,AN10,AN9 respectively
    
    _ADON = 1;    // AD1CON1<15> -- Turn on A/D
}



int main(void) {
    
    OC1CON2bits.SYNCSEL = 0x1F;  //sets pin 14 as a pwm
    OC1CON1bits.OCTSEL = 0b111;
    OC1CON1bits.OCM = 0b110;
    OC1CON2bits.OCTRIG = 0;
    
  
    
    _RCDIV = 0b00;   //sets postscalor to 1
    
    ANSA = 0; //MAKES IT DIGITAL
    ANSB = 0;
    _TRISA6 = 0;  // sets it to output for pwm, 
    _TRISA2 = 0;  //set this to pin 7    Pin 7 is left wheel
    _TRISA1 = 0;  //sets pin 3 as output Pin 3 is right wheel
    _TRISB2 = 1;  //pin 6 button input

    OC1RS = 166;  
    OC1R = 0;     
    _TRISB1 = 0;
    _LATA2 = 0; //pin 4 as dir
    _LATA1 = 0; //pin 3 as dir

    // Configure A/D
    config_pins_for_ad();
    config_ad();
    
    static double theVoltage[12];

    while(1){
        
        //QRD voltage calculation. TAs recommended using low pass filters to prevent unneeded noise from getting through and causing problems
        theVoltage[18] = (double)ADC1BUF9/4095.0 * 3.3;  // Pin 18 = Ball sensing QRD
        theVoltage[17] = (double)ADC1BUF10/4095.0 * 3.3; // Pin 17 = left QRD
        theVoltage[16] = (double)ADC1BUF11/4095.0 * 3.3; // Pin 16 = Center QRD
        theVoltage[15] = (double)ADC1BUF12/4095.0 * 3.3; // Pin 15 = Right QRD
        Line_Threshold_Voltage = 1.5 //volts
        
        if (theVoltage[17] < Line_Threshold_Voltage && theVoltage[16] > Line_Threshold_Voltage) {
            // QRD 17 will be on the line, so it will go low and the QRD 16 should go high because it is off the line. 
            // this will cause the robot to turn right
            OC1RS = 166;
            OC1R = OC1RS;
        }

        if else (theVoltage[15] < Line_Threshold_Voltage && theVoltage[16] > Line_Threshold_Voltage) {
            // QRD 15 will be on the line, so it will go low and the QRD 16 should go high because it is off the line. 
            // this will cause the robot to turn left
            OC1RS = 166;
            OC1R = OC1RS;
        }
    
    }
    return 0;
}
